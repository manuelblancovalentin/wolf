#!/bin/bash
set -euo pipefail

# Opt-in real ORFS integration test. It is never run by tests/run.

WOLF_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
: "${ORFS_ROOT:?Set ORFS_ROOT to an OpenROAD-flow-scripts/flow checkout.}"
ORFS_ROOT=$(cd -- "$ORFS_ROOT" && pwd)

ORFS_FLOW_VARIANT="${ORFS_FLOW_VARIANT:-wolf_ibex_asap7_1050ps_headless}"
case "$ORFS_FLOW_VARIANT" in
    wolf_ibex_asap7_1050ps*)
        ;;
    *)
        echo "Refusing non-dedicated ORFS_FLOW_VARIANT: $ORFS_FLOW_VARIANT" >&2
        echo "Use a variant beginning with wolf_ibex_asap7_1050ps." >&2
        exit 2
        ;;
esac

ORFS_RESULTS_DIR="${ORFS_ROOT}/results/asap7/ibex/${ORFS_FLOW_VARIANT}"
ORFS_REPORTS_DIR="${ORFS_ROOT}/reports/asap7/ibex/${ORFS_FLOW_VARIANT}"
if [[ -e "$ORFS_RESULTS_DIR" || -e "$ORFS_REPORTS_DIR" ]]; then
    echo "Refusing to reuse existing ORFS regression output:" >&2
    echo "  $ORFS_RESULTS_DIR" >&2
    echo "Choose a new dedicated ORFS_FLOW_VARIANT; this harness never cleans results." >&2
    exit 2
fi

WOLF_INTEGRATION_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/wolf-orfs-ibex.XXXXXX")
cleanup() {
    rm -rf -- "$WOLF_INTEGRATION_ROOT"
}
trap cleanup EXIT

export WOLF_HOME="${WOLF_INTEGRATION_ROOT}/state"
export WOLF_ENV_DIR="${WOLF_HOME}/envs/orfs-ibex"
export WOLF_ENV_NAME="orfs-ibex"
export WOLF_WORKSPACE_DIR="${WOLF_INTEGRATION_ROOT}/workspace"
export ORFS_ROOT
export ORFS_DESIGN_CONFIG="${ORFS_ROOT}/designs/asap7/ibex/config.mk"
ORFS_STOCK_SDC="${ORFS_ROOT}/designs/asap7/ibex/constraint.sdc"
export ORFS_SDC_FILE="${ORFS_ROOT}/designs/asap7/ibex/constraint.wolf_ibex_asap7_1050ps.sdc"
python3 "${WOLF_ROOT}/tests/integration/prepare_orfs_ibex_sdc.py" \
    "$ORFS_STOCK_SDC" "$ORFS_SDC_FILE"
export ORFS_FLOW_VARIANT
if [[ -z "${ORFS_CONTAINER_RUNTIME:-}" ]]; then
    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        export ORFS_CONTAINER_RUNTIME=podman
    else
        export ORFS_CONTAINER_RUNTIME=docker
    fi
fi
export ORFS_MAKE_VARS=$'SWAP_ARITH_OPERATORS=\nOPENROAD_HIERARCHICAL=0'

export ORFS_CONTAINER_IMAGE="${ORFS_CONTAINER_IMAGE:-openroad/orfs:latest}"

mkdir -p "$WOLF_ENV_DIR"
printf 'Running ORFS Ibex regression with variant %s\n' "$ORFS_FLOW_VARIANT"
bash "${WOLF_ROOT}/bin/wolf.run" \
    --backend orfs \
    --design ibex \
    --process asap7 \
    --runtag "$ORFS_FLOW_VARIANT" \
    --yes \
    -from synth \
    -to finish

# ORFS creates its canonical acceptance metadata from the completed logs,
# reports, and results. This is report collection, not another implementation
# stage; the physical-design stage sequence above remains synth through finish.
ORFS_METADATA_ARGS=(
    make
    "DESIGN_CONFIG=/work/designs/asap7/ibex/config.mk"
    "FLOW_VARIANT=${ORFS_FLOW_VARIANT}"
    "SDC_FILE=/work/designs/asap7/ibex/constraint.wolf_ibex_asap7_1050ps.sdc"
    "SWAP_ARITH_OPERATORS="
    "OPENROAD_HIERARCHICAL=0"
    metadata-generate
)
ORFS_METADATA_USER_ARGS=(--user "$(id -u):$(id -g)")
if [[ "$ORFS_CONTAINER_RUNTIME" == podman ]]; then
    ORFS_METADATA_USER_ARGS=(--userns=keep-id --user "$(id -u):$(id -g)")
fi
"$ORFS_CONTAINER_RUNTIME" run --rm -i \
    "${ORFS_METADATA_USER_ARGS[@]}" \
    -e FLOW_HOME=/OpenROAD-flow-scripts/flow \
    -e WORK_HOME=/work \
    -e DISPLAY= \
    -e QT_QPA_PLATFORM=offscreen \
    -v "${ORFS_ROOT}:/work:Z" \
    -w "${ORFS_CONTAINER_WORKDIR:-/OpenROAD-flow-scripts/flow}" \
    "$ORFS_CONTAINER_IMAGE" "${ORFS_METADATA_ARGS[@]}"

python3 "${WOLF_ROOT}/tests/integration/check_orfs_ibex.py" "$ORFS_REPORTS_DIR"
